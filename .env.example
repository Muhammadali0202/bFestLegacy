# MongoDB Connection URI (Required for Vercel / Real-Time Cloud Persistence)
# 1. Create a free cluster at https://www.mongodb.com/cloud/atlas
# 2. Under Network Access, allow 0.0.0.0/0 (so Vercel serverless functions can connect)
# 3. Copy your connection string and replace <username> and <password>:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/bfest_db?retryWrites=true&w=majority

# JWT Secret for Session Signing
JWT_SECRET=bfest_super_secret_2027_key

# Webhook Secret for Google Forms Integration
GOOGLE_FORM_WEBHOOK_SECRET=bfest_google_form_2027
